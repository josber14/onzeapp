model P2PChatState {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  exchange          String
  orderNumber       String
  state             String    @default("new")
  counterparty      String?
  isCompany         Boolean   @default(false)
  isReturning       Boolean   @default(false)
  previousBank      String?
  chosenBank        String?
  chosenAccountIds  Json?
  // IDs de cuenta en el MISMO orden exacto mostrado en el último menú
  // "1) Banco X 2) Banco Y..." — se usa para interpretar un "1"/"2"/"3"
  // numérico. Nunca se re-deriva el orden fresco de la base de datos al
  // interpretar la respuesta: si el orden de las cuentas cambia (ej. un
  // reordenamiento manual) entre que se muestra el menú y que el comprador
  // responde, un número ya no correspondería al banco que realmente vio.
  pendingBankMenuIds Json?
  // El estado en el que estaba la conversación justo antes del aviso de
  // "orden por vencer" (awaiting_problem) — se usa para volver ahí una vez
  // resuelto ese aviso puntual, en vez de forzar siempre a "account_sent"
  // sin importar en qué parte de la conversación se haya interrumpido.
  preInterruptState  String?
  erutRequested     Boolean   @default(false)
  erutReceived      Boolean   @default(false)
  retryCount        Int       @default(0)
  transferFailCount Int       @default(0)
  // Se fija la PRIMERA vez que se manda el aviso de "tu orden está por
  // vencer" — nunca se vuelve a null. Evita que el mismo aviso se repita en
  // cada ciclo (~15s) durante toda la ventana de 4.5 min, interrumpiendo una
  // y otra vez la respuesta real del comprador a la pregunta original (bug
  // real confirmado en vivo, jul 2026: una orden se canceló porque el
  // comprador nunca alcanzó a responder "personal/empresa" antes de que el
  // aviso volviera a interrumpir).
  expiryWarnedAt    DateTime?
  // Suma acumulada (CLP) de los montos leídos en los comprobantes de pago
  // que el comprador mandó como imagen (ver classifyImage en chat-brain.ts).
  // Se acumula porque un comprador puede dividir el pago en varias
  // transferencias (ej. 250.000 + 250.000 para completar una orden de
  // 500.000) -- comparar cada imagen suelta contra el total completo daría
  // una falsa alarma en un pago dividido legítimo. La comparación real
  // contra el total de la orden ocurre recién cuando se marca "Pagado".
  receivedReceiptsClp Decimal? @db.Decimal(18, 2)
  // Se fija la primera vez que se avisa "recuerda marcar Pagado" (comprobante
  // recibido pero la orden todavía no figura como pagada 1 min después) --
  // mismo principio que expiryWarnedAt, para no repetir el aviso en cada
  // ciclo mientras la condición se siga cumpliendo.
  markPaidReminderSentAt DateTime?
  // Se fija cuando el bot responde una duda sobre el nombre del titular
  // (matchHolderNameConcern) -- pedido explícito del usuario (ago 2026):
  // caso real donde el comprador partió su duda en 2 mensajes separados
  // ("Jorber Rafael Marcano ?" y, 3 min después, "ese nombre es suyo??" sin
  // repetir el nombre) -- el segundo mensaje, solo, no calzaba con ningún
  // matcher y caía al respaldo de IA, que inventó una pregunta genérica en
  // vez de repetir la confirmación correcta. Con esta marca, un mensaje
  // corto de seguimiento poco después (ver holderNameFollowupOk en
  // chat-agent.ts) se sigue tratando como el mismo tema. holderNameConfirmed
  // guarda CUÁL de las 2 respuestas se dio (nombre correcto vs. escalar a
  // asesor) para repetir la misma si hace falta, nunca inventar una nueva.
  holderNameConcernAt DateTime?
  holderNameConfirmed Boolean?
  // Se fija en cuanto el CLIENTE avisa (por texto) que va a pagar en varias
  // partes/cuentas -- ej. dice que su banco tiene límite, nombra 2+ bancos,
  // o pide "todas las cuentas". Sirve para que, al llegar un comprobante de
  // pago por imagen (ver classifyImage en chat-brain.ts), el bot sepa si un
  // monto menor al total es un pago dividido esperado (no avisar nada, solo
  // acumular) o una señal real de que falta dinero (avisar de inmediato).
  // Pedido explícito del usuario (ago 2026): caso real donde un comprador
  // avisó que pagaría en 3 partes, mandó el primer comprobante, y el bot
  // solo respondió un genérico "vi tu comprobante, marca Pagado" sin nunca
  // verificar el monto contra el total.
  splitPaymentDeclared Boolean @default(false)
  partialAmount     Decimal?  @db.Decimal(18, 8)
  totalAmount       Decimal?  @db.Decimal(18, 8)
  realName          String?
  // Primer nombre de pila ya resuelto (vía IA, ver resolveFirstName en
  // chat-brain.ts) -- se calcula UNA VEZ cuando se captura realName y se
  // reutiliza en todos los saludos/mensajes de esta conversación. Necesario
  // porque el orden de realName varía en la práctica ("APELLIDO APELLIDO
  // NOMBRE" en unos casos, "NOMBRE NOMBRE APELLIDO APELLIDO" en otros,
  // confirmado con 20 ejemplos reales jul 2026) -- no hay una posición fija
  // que funcione siempre, así que adivinar por índice llamaba a la persona
  // por su apellido en casi la mitad de los casos reales.
  firstName         String?
  pendingFirstMsg   String?
  lastClientMsgAt   DateTime?
  lastBotMsgAt      DateTime?
  lastBotMsg        String?
  lastClientMsgSeen String?
  appealAt          DateTime?
  paidAt            DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  Tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, exchange, orderNumber])
  @@index([tenantId, exchange, state])
}

// El apodo de Binance que se ve ANTES del pago (order.counterPartNickName)
// viene enmascarado a 3 letras + asteriscos y colisiona entre compradores
// distintos (confirmado en vivo jul 2026, ver comentario de getBuyerHistory
// en chat-agent.ts) — no sirve para reconocer "es la misma persona de antes".
// El evento de chat "seller_payed" (dispara cuando el comprador marca
// "Pagado") sí trae el apodo REAL sin enmascarar y el nombre legal completo.
// Esta tabla guarda esa asociación la primera vez que se ve, para poder
// reconocer a un comprador recurrente en un pedido FUTURO — nunca en el
// saludo inicial del MISMO pedido, porque ese evento todavía no ocurrió.
model P2PBuyerIdentity {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  exchange   String
  label      String   @default("ONZE")
  nickName   String
  realName   String
  // Mismo motivo que P2PChatState.firstName -- primer nombre de pila ya
  // resuelto vía IA, para no tener que re-derivarlo cada vez que se
  // reconoce a un cliente frecuente.
  firstName  String?
  orderCount Int      @default(1)
  lastBank      String?
  lastAccountId Int?
  lastIsCompany Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, exchange, label, nickName])
}

// Bloqueo real (no en memoria) contra procesamiento concurrente del chat.
// Necesario porque Vercel puede levantar varias instancias del mismo
// servidor en paralelo para atender /api/p2p/bot/cycle (llamado cada
// ~300ms) — un bloqueo en memoria de una instancia no lo ve otra instancia
// distinta. `id` = `${tenantId}:${label}:${exchange}`. Confirmado en vivo
// jul 2026: incluso con el bloqueo en memoria, el mismo mensaje del
// comprador seguía generando respuestas contradictorias.
model ChatProcessingLock {
  id       String   @id
  lockedAt DateTime @default(now())
}

