generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id                         Int            @id @default(autoincrement())
  code                       String         @unique
  name                       String
  description                String?
  priceMonthly               Decimal?       @db.Decimal(12, 2)
  currencyCode               String         @default("USD")
  maxOperators               Int?
  allowBasePropia            Boolean        @default(false)
  allowInternalOperatorAdmin Boolean        @default(false)
  allowKycModule             Boolean        @default(false)
  allowUsdtAnalysis          Boolean        @default(false)
  allowPairAdmin             Boolean        @default(false)
  active                     Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  subscriptions              Subscription[]
  tenants                    Tenant[]
}

model Tenant {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique
  legalName             String?
  tradeName             String
  ownerUserId           Int?
  dataSourceMode        DataSourceMode
  planId                Int?
  isOnzeInternal        Boolean                @default(false)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  balanceMovements      BalanceMovement[]
  binanceCredentials    BinanceCredentials[]
  binanceOrders         BinanceOrder[]
  bybitCredentials      BybitCredentials[]
  bybitOrders           BybitOrder[]
  collaboratorPayments  CollaboratorPayment[]
  dataSources           DataSource[]
  earningsMovements     EarningsMovement[]
  expenses              Expense[]
  initialCapitals       InitialCapital[]
  internalFundings      InternalFunding[]
  liquidityAlerts       LiquidityAlert[]
  OkxCredentials        OkxCredentials[]
  operations            Operation[]
  customers             OperatorCustomer[]
  P2PAccount            P2PAccount[]
  p2pBotConfig          P2PBotConfig?
  P2PBotExchangeConfig  P2PBotExchangeConfig[]
  p2pBotLogs            P2PBotLog[]
  p2pBotOrders          P2PBotOrder[]
  p2pBotAds             P2PBotAd[]
  p2pChatStates         P2PChatState[]
  p2pBuyerIdentities    P2PBuyerIdentity[]
  p2pBotMarketSnapshots P2PBotMarketSnapshot[]
  p2pCapacities         P2PCapacity[]
  p2pManualSales        P2PManualSale[]
  p2pCycles             P2PCycle[]
  p2pWebAuthnCredentials P2PWebAuthnCredential[]
  p2pWebAuthnChallenges P2PWebAuthnChallenge[]
  p2pReleaseAuthTokens  P2PReleaseAuthToken[]
  usdtClients           UsdtClient[]
  usdtMarginTiers       UsdtMarginTier[]
  usdtPurchaseIntents   UsdtPurchaseIntent[]
  usdtIncomingTransfers UsdtIncomingTransfer[]
  usdtPriceTicks        UsdtPriceTick[]
  adminNotifications    AdminNotification[]
  usdtWithdrawalAddresses UsdtWithdrawalAddress[]
  usdtWithdrawals       UsdtWithdrawal[]
  partnerAccounts       PartnerAccount[]
  partnerCapacities     PartnerCapacity[]
  partnerSales          PartnerSale[]
  partnerWithdrawals    PartnerWithdrawal[]
  partnerCapitalLedger  PartnerCapitalLedger[]
  rateLists             RateList[]
  subscriptions         Subscription[]
  ownerUser             User?                  @relation("TenantOwner", fields: [ownerUserId], references: [id])
  plan                  Plan?                  @relation(fields: [planId], references: [id])
  balances              TenantCountryBalance[]
  pairs                 TenantPair[]
  settings              TenantSettings?
  users                 User[]
}

model Subscription {
  id                     Int       @id @default(autoincrement())
  tenantId               Int
  planId                 Int
  status                 String
  startedAt              DateTime?
  endsAt                 DateTime?
  externalProvider       String?
  externalSubscriptionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  plan                   Plan      @relation(fields: [planId], references: [id])
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                   Int                   @id @default(autoincrement())
  tenantId             Int?
  role                 AccountRole
  status               AccountStatus         @default(pendiente)
  email                String                @unique
  passwordHash         String
  fullName             String
  phone                String?
  residenceCountryCode String?
  operatorMode         OperatorMode?
  dataSourceMode       DataSourceMode?
  percentageRate       Decimal?              @db.Decimal(8, 4)
  partnerSharePercent  Decimal?              @db.Decimal(8, 4)
  canManageOperators   Boolean               @default(false)
  canConnectOwnSheet   Boolean               @default(false)
  canEditBranding      Boolean               @default(false)
  notes                String?
  approvedByUserId     Int?
  approvedAt           DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            AuditLog[]
  collaboratorPayments CollaboratorPayment[]
  earningsMovements    EarningsMovement[]
  expenses             Expense[]
  createdOperations    Operation[]
  ownedCustomers       OperatorCustomer[]
  rateLists            RateList[]
  ownedTenant          Tenant[]              @relation("TenantOwner")
  approvedBy           User?                 @relation("UserApprovals", fields: [approvedByUserId], references: [id])
  approvedUsers        User[]                @relation("UserApprovals")
  tenant               Tenant?               @relation(fields: [tenantId], references: [id])
  reviewedKycs         UserKyc[]             @relation("KycReviewer")
  kyc                  UserKyc?

  @@index([tenantId])
  @@index([status])
}

model UserKyc {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  status                KycStatus @default(no_requerido)
  documentType          String?
  documentNumber        String?
  documentFrontUrl      String?
  documentBackUrl       String?
  selfieUrl             String?
  addressProofUrl       String?
  declarationAccepted   Boolean   @default(false)
  declarationAcceptedAt DateTime?
  reviewedByUserId      Int?
  reviewedAt            DateTime?
  reviewNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  reviewedBy            User?     @relation("KycReviewer", fields: [reviewedByUserId], references: [id])
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataSource {
  id                Int            @id @default(autoincrement())
  tenantId          Int
  mode              DataSourceMode
  provider          String
  sourceName        String
  sheetUrl          String?
  csvUrl            String?
  isPrimary         Boolean        @default(true)
  syncEnabled       Boolean        @default(true)
  lastSyncedAt      DateTime?
  validationStatus  String?
  validationMessage String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Country {
  id                       Int                    @id @default(autoincrement())
  code                     String                 @unique
  name                     String
  currencyCode             String
  flagEmoji                String?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  balanceMovements         BalanceMovement[]
  expenses                 Expense[]
  initialCapitals          InitialCapital[]
  fundingSourceLinks       InternalFunding[]      @relation("FundingSourceCountry")
  fundingTargetLinks       InternalFunding[]      @relation("FundingTargetCountry")
  liquidityAlerts          LiquidityAlert[]
  convertedProfitOps       Operation[]            @relation("OperationConvertedProfitTargetCountry")
  destinationOps           Operation[]            @relation("OperationDestinationCountry")
  originOperations         Operation[]            @relation("OperationOriginCountry")
  profitBaseOps            Operation[]            @relation("OperationProfitBaseCountry")
  shortageOps              Operation[]            @relation("OperationShortageCountry")
  rateListPairsDestination RateListPair[]         @relation("RateListPairDestination")
  rateListPairsOrigin      RateListPair[]         @relation("RateListPairOrigin")
  balances                 TenantCountryBalance[]
  destinationPairs         TenantPair[]           @relation("DestinationCountry")
  originPairs              TenantPair[]           @relation("OriginCountry")
}

model TenantPair {
  id                   Int              @id @default(autoincrement())
  tenantId             Int
  originCountryId      Int
  destinationCountryId Int
  pairCode             String
  active               Boolean          @default(true)
  decimals             Int?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  destinationCountry   Country          @relation("DestinationCountry", fields: [destinationCountryId], references: [id])
  originCountry        Country          @relation("OriginCountry", fields: [originCountryId], references: [id])
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates                TenantPairRate[]

  @@unique([tenantId, originCountryId, destinationCountryId])
  @@index([tenantId])
}

model TenantPairRate {
  id                   Int        @id @default(autoincrement())
  tenantPairId         Int
  buyOriginValue       Decimal?   @db.Decimal(18, 8)
  sellDestinationValue Decimal?   @db.Decimal(18, 8)
  costRate             Decimal?   @db.Decimal(18, 8)
  providerRate         Decimal?   @db.Decimal(18, 8)
  retailRate           Decimal?   @db.Decimal(18, 8)
  active               Boolean    @default(true)
  sourceRowRef         String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenantPair           TenantPair @relation(fields: [tenantPairId], references: [id], onDelete: Cascade)

  @@index([tenantPairId])
}

model OperatorCustomer {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  ownerUserId Int
  fullName    String
  phone       String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  operations  Operation[]
  ownerUser   User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Operation {
  id                                Int                 @id @default(autoincrement())
  tenantId                          Int
  createdByUserId                   Int
  operationNumber                   String
  operationDate                     DateTime
  operationTime                     DateTime            @default(now())
  operationType                     String?
  note                              String?
  customerId                        Int?
  customerNameSnapshot              String?
  operatorMode                      OperatorMode
  percentageRateSnapshot            Decimal?            @db.Decimal(8, 4)
  partnerSharePercentSnapshot       Decimal?            @db.Decimal(8, 4)
  originCountryId                   Int
  destinationCountryId              Int
  originCurrencyCode                String
  destinationCurrencyCode           String
  amountOrigin                      Decimal             @db.Decimal(18, 8)
  amountDestination                 Decimal?            @db.Decimal(18, 8)
  buyOriginValueSnapshot            Decimal?            @db.Decimal(18, 8)
  sellDestinationValueSnapshot      Decimal?            @db.Decimal(18, 8)
  costRateSnapshot                  Decimal?            @db.Decimal(18, 8)
  providerRateSnapshot              Decimal?            @db.Decimal(18, 8)
  retailRateSnapshot                Decimal?            @db.Decimal(18, 8)
  userOperatingRateSnapshot         Decimal?            @db.Decimal(18, 8)
  profitBaseCountryId               Int?
  profitBaseCurrencyCode            String?
  profitTotalAmount                 Decimal             @default(0) @db.Decimal(18, 8)
  operatorProfitAmount              Decimal             @default(0) @db.Decimal(18, 8)
  superAdminProfitAmount            Decimal             @default(0) @db.Decimal(18, 8)
  convertedProfit                   Boolean             @default(false)
  convertedProfitTargetCountryId    Int?
  convertedProfitTargetCurrencyCode String?
  convertedProfitAmount             Decimal?            @db.Decimal(18, 8)
  conversionProviderRateSnapshot    Decimal?            @db.Decimal(18, 8)
  payoutCurrencyMode                PayoutCurrencyMode?
  payoutAmountToOperator            Decimal?            @db.Decimal(18, 8)
  payoutCurrencyCode                String?
  payoutUsdtAmount                  Decimal?            @db.Decimal(18, 8)
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt
  liquidityShortage                 Decimal?            @db.Decimal(18, 8)
  liquidityStatus                   LiquidityStatus     @default(ok)
  needsFunding                      Boolean             @default(false)
  shortageCountryId                 Int?
  shortageCurrencyCode              String?
  deleted                           Boolean             @default(false)
  deletedAt                         DateTime?
  status                            String?
  onzeProfitOriginAmount            Decimal?            @db.Decimal(18, 8)
  onzeProfitOriginCurrencyCode      String?
  onzeProfitUsdt                    Decimal?            @db.Decimal(18, 8)
  operatorPayoutStatus              String?             @default("pending")
  operatorProfitConverted           Boolean             @default(false)
  operatorProfitFinalAmount         Decimal?            @db.Decimal(18, 8)
  operatorProfitFinalCurrencyCode   String?
  operatorProfitPaidAmount          Decimal?            @db.Decimal(18, 8)
  operatorProfitPendingAmount       Decimal?            @db.Decimal(18, 8)
  balanceMovements                  BalanceMovement[]
  earningsMovements                 EarningsMovement[]
  internalFundings                  InternalFunding[]
  liquidityAlerts                   LiquidityAlert[]
  convertedProfitTargetCountry      Country?            @relation("OperationConvertedProfitTargetCountry", fields: [convertedProfitTargetCountryId], references: [id])
  createdByUser                     User                @relation(fields: [createdByUserId], references: [id])
  customer                          OperatorCustomer?   @relation(fields: [customerId], references: [id])
  destinationCountry                Country             @relation("OperationDestinationCountry", fields: [destinationCountryId], references: [id])
  originCountry                     Country             @relation("OperationOriginCountry", fields: [originCountryId], references: [id])
  profitBaseCountry                 Country?            @relation("OperationProfitBaseCountry", fields: [profitBaseCountryId], references: [id])
  shortageCountry                   Country?            @relation("OperationShortageCountry", fields: [shortageCountryId], references: [id])
  tenant                            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, operationNumber])
  @@index([tenantId, operationDate])
  @@index([createdByUserId])
  @@index([operatorMode])
}

model TenantCountryBalance {
  id                     Int      @id @default(autoincrement())
  tenantId               Int
  countryId              Int
  balanceLocal           Decimal  @default(0) @db.Decimal(18, 8)
  buyOriginValueSnapshot Decimal? @db.Decimal(18, 8)
  balanceUsdt            Decimal? @db.Decimal(18, 8)
  sourceRef              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  country                Country  @relation(fields: [countryId], references: [id])
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryId])
  @@index([tenantId])
}

model InitialCapital {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  countryId    Int
  currencyCode String
  amount       Decimal  @db.Decimal(18, 8)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  country      Country  @relation(fields: [countryId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryId, currencyCode])
  @@index([tenantId])
}

model BalanceMovement {
  id           Int                      @id @default(autoincrement())
  tenantId     Int
  operationId  Int?
  fundingId    Int?
  countryId    Int
  currencyCode String
  direction    BalanceMovementDirection
  movementType BalanceMovementType
  amount       Decimal                  @db.Decimal(18, 8)
  note         String?
  createdAt    DateTime                 @default(now())
  country      Country                  @relation(fields: [countryId], references: [id])
  funding      InternalFunding?         @relation(fields: [fundingId], references: [id])
  operation    Operation?               @relation(fields: [operationId], references: [id])
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([operationId])
  @@index([fundingId])
  @@index([countryId])
}

model LiquidityAlert {
  id               Int                  @id @default(autoincrement())
  tenantId         Int
  operationId      Int
  countryId        Int
  currencyCode     String
  availableAmount  Decimal              @db.Decimal(18, 8)
  requiredAmount   Decimal              @db.Decimal(18, 8)
  shortageAmount   Decimal              @db.Decimal(18, 8)
  status           LiquidityAlertStatus @default(abierta)
  note             String?
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?
  internalFundings InternalFunding[]
  country          Country              @relation(fields: [countryId], references: [id])
  operation        Operation            @relation(fields: [operationId], references: [id], onDelete: Cascade)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([operationId])
  @@index([countryId])
  @@index([status])
}

model InternalFunding {
  id                 Int               @id @default(autoincrement())
  tenantId           Int
  operationId        Int?
  liquidityAlertId   Int?
  sourceCountryId    Int
  sourceCurrencyCode String
  sourceAmount       Decimal           @db.Decimal(18, 8)
  targetCountryId    Int
  targetCurrencyCode String
  targetAmount       Decimal           @db.Decimal(18, 8)
  referenceRate      Decimal?          @db.Decimal(18, 8)
  executedRate       Decimal           @db.Decimal(18, 8)
  costUsdt           Decimal?          @db.Decimal(18, 8)
  note               String?
  status             String            @default("completed")
  createdAt          DateTime          @default(now())
  balanceMovements   BalanceMovement[]
  liquidityAlert     LiquidityAlert?   @relation(fields: [liquidityAlertId], references: [id])
  operation          Operation?        @relation(fields: [operationId], references: [id])
  sourceCountry      Country           @relation("FundingSourceCountry", fields: [sourceCountryId], references: [id])
  targetCountry      Country           @relation("FundingTargetCountry", fields: [targetCountryId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([operationId])
  @@index([liquidityAlertId])
  @@index([sourceCountryId])
  @@index([targetCountryId])
}

model EarningsMovement {
  id           Int                  @id @default(autoincrement())
  tenantId     Int
  userId       Int
  operationId  Int?
  movementType EarningsMovementType
  amount       Decimal              @db.Decimal(18, 8)
  currencyCode String
  note         String?
  createdAt    DateTime             @default(now())
  operation    Operation?           @relation(fields: [operationId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([operationId])
}

model CollaboratorPayment {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  userId       Int
  currencyCode String
  amount       Decimal  @db.Decimal(18, 8)
  paymentDate  DateTime
  note         String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Expense {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  expenseDate     DateTime
  category        String
  countryId       Int
  currencyCode    String
  amount          Decimal  @db.Decimal(18, 8)
  note            String?
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  country         Country  @relation(fields: [countryId], references: [id])
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([countryId])
  @@index([expenseDate])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  tenantId    Int?
  action      String
  entityType  String
  entityId    String?
  payload     Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model TenantSettings {
  id                              Int      @id @default(autoincrement())
  tenantId                        Int      @unique
  inviteCode                      String?
  whatsappClosingNumber           String?
  sheetUrl                        String?
  allowInternalOperatorManagement Boolean  @default(false)
  allowPairCreation               Boolean  @default(false)
  allowCountryCreation            Boolean  @default(false)
  allowSheetSync                  Boolean  @default(true)
  allowUsdtAnalysis               Boolean  @default(false)
  allowKyc                        Boolean  @default(false)
  themeOverrides                  Json?
  p2pResetCutoff                  BigInt?
  // Clave de 4 dígitos para proteger "Liberar" en el panel P2P (jul 2026) —
  // nunca se guarda en texto plano, solo el hash (bcryptjs, mismo patrón que
  // el login). El bloqueo temporal es para que no se pueda "adivinar" por
  // fuerza bruta (4 dígitos = solo 10.000 combinaciones posibles).
  releasePinHash                  String?
  releasePinFailedAttempts        Int       @default(0)
  releasePinLockedUntil           DateTime?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Huella/Face ID registrada para proteger "Liberar" en el panel P2P — el
// estándar WebAuthn nunca nos da acceso a la huella en sí, solo una llave
// pública que sirve para VERIFICAR firmas hechas con el sensor del propio
// dispositivo del usuario.
model P2PWebAuthnCredential {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   Json?
  deviceLabel  String?
  createdAt    DateTime @default(now())
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Challenge temporal de una ceremonia WebAuthn en curso (registro o
// autenticación) — se genera, se guarda acá, y se borra/expira apenas se
// usa. Nunca vive más que unos minutos.
model P2PWebAuthnChallenge {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  challenge   String
  purpose     String
  // Solo se usa cuando purpose="authenticate" para liberar una orden — así
  // auth-verify sabe a qué orden atar el token que emite al validar la huella.
  orderNumber String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Token corto (~2 min) que autoriza UNA liberación puntual de UNA orden
// específica — se emite recién después de validar el PIN o la huella
// correctamente, y se consume (marca used=true) al usarlo. Nunca se puede
// reutilizar para otra orden ni más de una vez.
model P2PReleaseAuthToken {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  token       String   @unique
  orderNumber String
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderNumber])
}

// ─── Clientes de venta de USDT al mayor (producto nuevo, 100% aislado del
// panel ONZE — login/sesión propios, ver lib/usdt-client-session.ts) ───

model UsdtClient {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  email            String
  passwordHash     String
  fullName         String
  // pending_kyc: recién registrado, KYC sin revisar. pending_approval: KYC
  // enviado, esperando aprobación manual del admin. approved: puede comprar.
  // rejected / suspended: acceso bloqueado.
  status           String    @default("pending_kyc")
  // Tope de compra por operación/período para este cliente — protege contra
  // que alguien cierre un precio con el proveedor y no pague. Null = sin
  // límite propio (usa el default general, si existe).
  purchaseLimitClp Decimal?  @db.Decimal(18, 2)
  // Margen fijo para ESTE cliente puntual — si está definido, se usa siempre
  // en vez de los tramos generales por monto (UsdtMarginTier). Null = sin
  // override, usa los tramos configurados.
  fixedMarginPct   Decimal?  @db.Decimal(6, 3)
  // 2FA (TOTP) propio del cliente — requerido para retirar. Cifrado
  // reversible porque hace falta el valor real para verificar cada código
  // (no es un hash). totpEnabled queda en false hasta que el cliente
  // confirme un código real durante la configuración.
  totpSecretEnc    String?
  totpEnabled      Boolean   @default(false)
  // Dirección y red donde el cliente quiere recibir sus retiros de USDT —
  // configurable por el propio cliente en su perfil, se usa como default en
  // la pantalla de Retirar.
  walletAddress    String?
  withdrawalNetwork String?  // "TRC20" | "ERC20" | "BEP20"
  // Datos del formulario de KYC tal como los captura el formulario propio del
  // usuario — guardado como JSON en vez de columnas fijas porque el formulario
  // real todavía no fue confirmado (evita inventar nombres de campo).
  kycData          Json?
  approvedAt       DateTime?
  approvedByUserId Int?
  // Throttle simple de /api/usdt-client/quote -- evita que una cuenta (o una
  // sesión comprometida) haga spam de cotizaciones reales contra Skipo.
  lastQuoteAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts         UsdtClientContact[]
  purchaseIntents  UsdtPurchaseIntent[]
  withdrawalAddresses UsdtWithdrawalAddress[]
  withdrawals      UsdtWithdrawal[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
}

// Libreta de direcciones propia del cliente — contactos externos guardados
// para no tener que escribir la dirección cada vez que retira/envía a la
// misma persona. Vive en nuestra base, no tiene relación con los "contacts"
// de la API de Skipo (esos son de la cuenta del admin, no del cliente).
model UsdtClientContact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  alias     String
  currency  String   @default("USDT")
  network   String   // "TRC20" | "ERC20" | "BEP20"
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    UsdtClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Tramos de margen configurables por monto (CLP) — ej: 10.000-99.999 un %,
// 100.000-499.999 otro %, etc. maxClp null = tramo más alto, sin techo.
model UsdtMarginTier {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  minClp    Decimal  @db.Decimal(18, 2)
  maxClp    Decimal? @db.Decimal(18, 2)
  marginPct Decimal  @db.Decimal(6, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Solicitud de compra de USDT de un cliente de Activos Digitales — se crea
// ANTES de que el cliente transfiera, con un código de referencia único para
// que la transferencia se pueda identificar sin ambigüedad (sobrevive a pago
// dividido en varias cuentas, montos idénticos en compras simultáneas, y
// errores de monto). El cliente solo puede comprar (status pasa a
// ready_to_buy) una vez que receivedClp alcanza requestedClp — nunca antes.
model UsdtPurchaseIntent {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  clientId       Int
  referenceCode  String
  requestedClp   Decimal   @db.Decimal(18, 2)
  receivedClp    Decimal   @default(0) @db.Decimal(18, 2)
  // awaiting_payment: esperando que llegue la plata. ready_to_buy: ya llegó,
  // el cliente puede apretar Comprar. completed: ya se ejecutó la compra en
  // Skipo. cancelled: el cliente/operador la dio de baja.
  status         String    @default("awaiting_payment")
  usdtAmount     Decimal?  @db.Decimal(18, 8)
  executedRate   Decimal?  @db.Decimal(18, 4)
  skipoOrdId     String?
  skipoConvertId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  readyAt        DateTime?
  executedAt     DateTime?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         UsdtClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transfers      UsdtIncomingTransfer[]

  @@unique([tenantId, referenceCode])
  @@index([tenantId, clientId, status])
}

// Dirección de retiro VERIFICADA para un cliente puntual -- a diferencia de
// UsdtClientContact (libreta libre, el cliente escribe cualquier dirección
// sin ninguna validación), esta SOLO la puede crear el operador (admin)
// desde el panel, y siempre está atada a un `providerContactId` real ya
// whitelisteado del lado del proveedor. Decisión explícita del usuario (ago
// 2026): el cliente nunca puede escribir una dirección nueva y esperar que
// funcione -- el proveedor exige que la dirección exista como "contacto"
// de SU lado antes de poder retirar a ella, y esa alta solo se puede hacer
// manualmente desde el panel del proveedor. Por eso el flujo real es:
// admin agrega el contacto en el panel del proveedor -> admin registra acá
// la misma dirección con su providerContactId -> el cliente ya la puede
// elegir para retirar.
model UsdtWithdrawalAddress {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  clientId         Int
  alias            String
  assetSymbol      String   @default("USDT")
  networkSymbol    String   // ej: "BEP20", "TRC20", "ERC20" -- solo para mostrar al cliente
  address          String   // solo para mostrar al cliente, NUNCA se manda tal cual al proveedor
  // Id del contacto ya whitelisteado del lado del proveedor -- esto es lo
  // que realmente se manda para ejecutar el retiro, no `address`.
  providerContactId String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           UsdtClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  withdrawals      UsdtWithdrawal[]

  @@index([tenantId, clientId, active])
}

// Registro de cada retiro pedido/ejecutado. `providerWithdrawalId` es el id
// interno del proveedor -- server-side únicamente, jamás se devuelve en
// ninguna respuesta al cliente (ver toClientWithdrawal en lib/usdt-purchase.ts).
model UsdtWithdrawal {
  id                   Int      @id @default(autoincrement())
  tenantId             Int
  clientId             Int
  addressId            Int
  amountUsdt           Decimal  @db.Decimal(18, 8)
  feeUsdt              Decimal? @db.Decimal(18, 8)
  totalUsdt            Decimal? @db.Decimal(18, 8)
  // pending: aceptado por el proveedor, esperando confirmación on-chain.
  // completed / failed: estado terminal (ver GET /withdrawals/{id} o webhook
  // del lado del proveedor). error: nuestra propia ejecución falló antes de
  // llegar a un estado del proveedor (ej. red caída) -- nunca se movió nada.
  status               String   @default("pending")
  providerWithdrawalId String?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  completedAt          DateTime?
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client               UsdtClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address              UsdtWithdrawalAddress @relation(fields: [addressId], references: [id])

  @@index([tenantId, clientId, status])
}

// Una transferencia real recibida en la cuenta bancaria del operador,
// detectada leyendo los avisos de "transferencia recibida" del banco. Nunca
// se confía en el remitente visible del correo — authPassed refleja el
// resultado real de la validación SPF/DKIM contra el dominio esperado.
model UsdtIncomingTransfer {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  purchaseIntentId Int?
  amountClp        Decimal   @db.Decimal(18, 2)
  payerName        String?
  rawComment       String?
  // "code": matcheado por el código de referencia en el comentario/glosa.
  // "name_fallback": matcheado por nombre+monto, siempre needsReview=true.
  // "manual": el operador lo asoció a mano desde la bandeja de revisión.
  matchMethod      String?
  needsReview      Boolean   @default(true)
  reviewedByUserId Int?
  // Message-ID real del correo — evita procesar el mismo aviso dos veces si
  // el cron se solapa o el correo llega más de una vez.
  emailMessageId   String    @unique
  sourceEmail      String
  authPassed       Boolean
  receivedAt       DateTime
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseIntent   UsdtPurchaseIntent? @relation(fields: [purchaseIntentId], references: [id])

  @@index([tenantId, needsReview])
}

// Historial simple de precio USDT/CLP para mostrarle al cliente cómo se ha
// movido en los últimos minutos — un tick por cada cotización real pedida a
// Skipo, no es una fuente de verdad para ejecutar compras (esas siempre
// piden una cotización fresca).
model UsdtPriceTick {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  rate      Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// Notificaciones para el admin sobre actividad de clientes USDT -- pedido
// explícito del usuario (ago 2026).
// "purchase_requested"/"purchase_cancelled": saber apenas un cliente pide
// comprar (para poder fondear Skipo a tiempo, ANTES de que el cliente
// apriete "Comprar") y si cancela. requestedClp es lo que pidió el cliente;
// skipoClpNeeded es lo que el admin debe mandar a Skipo -- son DISTINTOS
// porque el cliente paga a la tasa CON margen y el admin compra en Skipo a
// la tasa SIN margen (más barata), así que skipoClpNeeded siempre es menor.
// "wallet_added": el cliente guardó/cambió su wallet de retiro en su
// perfil -- para que el admin pueda ir a agregarla como contacto en Skipo
// sin tener que pedírsela por WhatsApp.
model AdminNotification {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  type             String   // "purchase_requested" | "purchase_cancelled" | "wallet_added"
  clientName       String
  requestedClp     Decimal? @db.Decimal(18, 2)
  skipoClpNeeded   Decimal? @db.Decimal(18, 2)
  walletAddress    String?
  withdrawalNetwork String?
  purchaseIntentId Int?
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, read, createdAt])
}

model PasswordResetCode {
  id        Int       @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([code])
}

model BinanceCredentials {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  label        String    @default("ONZE")
  apiKey       String
  secretKey    String
  isActive     Boolean   @default(true)
  lastTestedAt DateTime?
  testStatus   String?
  // Contraseña de fondos de Binance (Fund Password) — DISTINTA de apiKey/secretKey
  // y de la clave de login. Binance la exige (cifrada con su llave RSA pública,
  // ver lib/p2p-bot/binance-adapter.ts releaseAssets) en cada liberación de
  // orden C2C. Cifrada acá con AES-256-GCM (reversible, no hash) porque hace
  // falta el valor real para cifrarla de nuevo con la llave RSA de Binance en
  // cada llamada — nunca se expone en ninguna respuesta de API.
  fundPasswordEnc String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@index([tenantId])
}

model BinanceOrder {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  orderNumber         String   @unique
  tradeType           String
  asset               String
  fiat                String
  amount              Decimal  @db.Decimal(18, 8)
  totalPrice          Decimal  @db.Decimal(18, 8)
  unitPrice           Decimal  @db.Decimal(18, 8)
  commission          Decimal  @db.Decimal(18, 8)
  orderStatus         String
  createTime          BigInt
  createdAt           DateTime
  syncedAt            DateTime @default(now())
  counterPartNickName String?
  payMethodName       String?
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createTime])
}

// Espejo de BinanceOrder para el historial de ventas P2P de Bybit. Bybit no
// cobra comisión (a diferencia de Binance) -- el campo commission siempre
// queda en 0, se mantiene solo por simetría de esquema con BinanceOrder.
model BybitOrder {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  orderNumber         String   @unique
  tradeType           String
  asset               String
  fiat                String
  amount              Decimal  @db.Decimal(18, 8)
  totalPrice          Decimal  @db.Decimal(18, 8)
  unitPrice           Decimal  @db.Decimal(18, 8)
  commission          Decimal  @default(0) @db.Decimal(18, 8)
  orderStatus         String
  createTime          BigInt
  createdAt           DateTime
  syncedAt            DateTime @default(now())
  counterPartNickName String?
  payMethodName       String?
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createTime])
}

model P2PCapacity {
  id                  String    @id
  tenantId            Int
  provider            String
  capacityClp         Decimal   @db.Decimal(18, 2)
  buyPrice            Decimal   @db.Decimal(18, 4)
  usdtAmount          Decimal   @db.Decimal(18, 8)
  date                String
  status              String    @default("active")
  finishedAt          DateTime?
  finalSoldUsdt       Decimal?  @db.Decimal(18, 8)
  finalClpReceived    Decimal?  @db.Decimal(18, 2)
  finalCommissionUsdt Decimal?  @db.Decimal(18, 8)
  finalCommissionClp  Decimal?  @db.Decimal(18, 2)
  finalSaleParts      Json?
  manualPaymentClp    Decimal?  @db.Decimal(18, 2)
  manualPaymentsClp   Decimal?  @db.Decimal(18, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// Ventas "manuales" del panel de Capacity P2P (Bybit/OKX sin API conectada,
// o correcciones manuales de Binance) -- antes SOLO vivían en localStorage
// del navegador (onze_p2p_bybit_orders / onze_p2p_okx_orders), nunca en
// Neon, a diferencia de P2PCapacity que ya se migró a Neon como única
// fuente de verdad. Si se limpiaba el navegador o se entraba desde otro
// dispositivo, estas ventas desaparecían del cálculo de capacity sin aviso.
// El id reutiliza el mismo "manual_<timestamp>_<random>" que ya generaba el
// panel como orderNumber, para no duplicar identificadores.
model P2PManualSale {
  id         String   @id
  tenantId   Int
  exchange   String
  amount     Decimal  @db.Decimal(18, 8)
  totalPrice Decimal  @db.Decimal(18, 2)
  unitPrice  Decimal  @db.Decimal(18, 4)
  commission Decimal  @default(0) @db.Decimal(18, 8)
  executedAt DateTime
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([exchange])
}

// Idempotencia para /api/admin/skipo/confirm -- evita que un doble clic o un
// reintento de red confirme la misma cotización de Skipo dos veces. El
// ordId es único por cotización (viene de client.getQuotation), así que
// reclamarlo con un create() que choca por PK ante un ordId repetido es
// suficiente sin necesitar locks adicionales.
model SkipoConfirmLock {
  ordId     String   @id
  tenantId  Int
  createdAt DateTime @default(now())
}

// ─── Dashboard de cuenta del socio (Binance separado, 100% aislado del bot ONZE/ZINPLE) ───

model PartnerAccount {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  label             String    @default("SOCIO")
  name              String?
  apiKey            String
  secretKey         String
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?
  // Las ventas anteriores a esta fecha se ignoran en las estadísticas (aunque
  // queden guardadas en PartnerSale por si sirven de referencia después) —
  // permite "arrancar la cuenta" desde una fecha elegida por el usuario, sin
  // que el historial de 90 días que trae la primera sincronización infle los
  // números.
  trackingStartDate DateTime?
  // Capital inicial en USDT (tarjeta "Capital P2P", mismo concepto que el
  // dashboard ONZE) — se suma a la ganancia del mes en curso para mostrar el
  // capital total. Editable desde el panel, null hasta que el usuario lo
  // defina la primera vez.
  initialCapitalUsdt Decimal? @db.Decimal(18, 8)
  // % de PPM (Pago Provisional Mensual, SII) a aplicar sobre el CLP recibido
  // del período — pedido explícito del usuario (jul 2026): todavía no
  // confirma el % con su contadora, así que queda editable y null hasta que
  // lo defina (la tarjeta muestra "Configura el %" mientras tanto).
  ppmPct            Decimal?  @db.Decimal(6, 3)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@index([tenantId])
}

// Registro libre de un retiro real de ganancia -- pedido explícito del
// usuario (jul 2026): puede anotarse en cualquier momento (a mitad de mes,
// si alguno necesita retirar antes) y también sirve de insumo para "cerrar"
// un período (ver PartnerCapitalLedger): la suma de retiros de un período
// contra la ganancia neta de ese período determina el sobrante que se
// agrega al capital inicial.
model PartnerWithdrawal {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  label       String   @default("SOCIO")
  person      String
  amountUsdt  Decimal  @db.Decimal(18, 8)
  note        String?
  withdrawnAt DateTime @default(now())
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, label])
}

// Historial de cuándo se sumó ganancia sin retirar al capital inicial --
// pedido explícito del usuario: "que exista como la referencia de cuál fue
// el saldo inicial y cuándo se le sumó a ese saldo, que lleve historial de
// fecha". Cada fila es un "cierre" de período: ganancia neta calculada,
// total retirado entre los dos, y lo que quedó sin retirar (addedUsdt) se
// suma al capital -- previousCapitalUsdt/newCapitalUsdt quedan fijos para
// siempre como registro histórico, aunque el capital actual se siga
// moviendo después.
model PartnerCapitalLedger {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  label              String   @default("SOCIO")
  periodFrom         DateTime
  periodTo           DateTime
  netProfitUsdt      Decimal  @db.Decimal(18, 8)
  totalWithdrawnUsdt Decimal  @db.Decimal(18, 8)
  addedUsdt          Decimal  @db.Decimal(18, 8)
  previousCapitalUsdt Decimal @db.Decimal(18, 8)
  newCapitalUsdt     Decimal  @db.Decimal(18, 8)
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, label])
}

model PartnerCapacity {
  id          String    @id
  tenantId    Int
  label       String    @default("SOCIO")
  provider    String
  capacityClp Decimal   @db.Decimal(18, 2)
  buyPrice    Decimal   @db.Decimal(18, 4)
  usdtAmount  Decimal   @db.Decimal(18, 8)
  date        String
  status      String    @default("active")
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    PartnerCapacityPayment[]

  @@index([tenantId, label])
  @@index([status])
}

// Pago manual aparte de las ventas sincronizadas de Binance — ej: el socio
// pagó directo al proveedor con plata propia (no proveniente de una venta).
// Se guarda como registro propio (no se resta directo de capacityClp) para
// mantener trazabilidad de cada ajuste, y porque NUNCA debe afectar el
// cálculo de costo/ganancia (que sale solo de PartnerSale vía FIFO en
// computeFifo) — solo reduce el saldo pendiente que se le muestra al socio.
model PartnerCapacityPayment {
  id         Int             @id @default(autoincrement())
  capacityId String
  amountClp  Decimal         @db.Decimal(18, 2)
  note       String?
  createdAt  DateTime        @default(now())
  capacity   PartnerCapacity @relation(fields: [capacityId], references: [id], onDelete: Cascade)

  @@index([capacityId])
}

model PartnerSale {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  label         String   @default("SOCIO")
  orderNumber   String
  amount        Decimal  @db.Decimal(18, 8)
  totalPrice    Decimal  @db.Decimal(18, 8)
  unitPrice     Decimal  @db.Decimal(18, 8)
  commission    Decimal? @db.Decimal(18, 8)
  fiat          String   @default("CLP")
  orderStatus   String   @default("COMPLETED")
  paymentMethod String?
  executedAt    DateTime
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

