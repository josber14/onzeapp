model P2PCycle {
  id               Int                  @id @default(autoincrement())
  tenantId         Int
  label            String               @default("ONZE")
  exchange         String               @default("binance")
  startTime        DateTime             @default(now())
  endTime          DateTime?
  status           String               @default("active")
  totalUsdt        Decimal              @default(0) @db.Decimal(18, 8)
  totalBinanceClp  Decimal              @default(0) @db.Decimal(18, 2)
  totalManualClp   Decimal              @default(0) @db.Decimal(18, 2)
  minCloseBalance  Decimal?             @db.Decimal(18, 8)
  firstOrderNumber String?
  firstOrderClp    Decimal?             @db.Decimal(18, 2)
  firstOrderTime   DateTime?
  lastOrderNumber  String?
  lastOrderClp     Decimal?             @db.Decimal(18, 2)
  lastOrderTime    DateTime?
  // Snapshot de las órdenes reales que se usaron para calcular los totales
  // de ARRIBA, guardado en el momento del cierre -- pedido explícito del
  // usuario (ago 2026): "las mismas órdenes que se ven afuera cuando está
  // el ciclo activo son las que se tienen que ver una vez finalizado". Antes
  // el detalle de un ciclo cerrado volvía a pedirle a Binance el historial
  // en vivo (ver /api/p2p/cycle/orders), pero ese endpoint de Binance es
  // eventualmente consistente (ya documentado en este proyecto) -- dos
  // llamadas casi idénticas podían traer una lista distinta a la que generó
  // los totales guardados. Guardando acá exactamente la misma lista que
  // produjo totalUsdt/totalBinanceClp, el detalle queda coherente siempre,
  // sin depender de una nueva consulta a Binance. Null para ciclos cerrados
  // ANTES de este cambio (fallback: la ruta re-consulta en vivo para esos).
  ordersJson       Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  manualSales      P2PCycleManualSale[]
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, exchange, label, status])
  @@index([tenantId])
}

model P2PCycleManualSale {
  id        Int      @id @default(autoincrement())
  cycleId   Int
  concept   String
  amountClp Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  cycle     P2PCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
}

// Historial de cambios de la tabla "tasa de compra venta" (hoja "tasas web",
// columnas G:pais H:compra I:venta) -- pedido explícito del usuario (ago
// 2026), visible SOLO para super_admin_global en el panel ("Historial de
// tasa" dentro de "Crea tu tasa del día"). Un cron (ver vercel.json,
// /api/internal/rate-history-check) revisa la hoja publicada cada 5 min y
// SOLO inserta una fila nueva por país cuando compra o venta cambiaron
// respecto al último valor guardado -- así la tabla queda como una línea de
// tiempo de cambios reales, no un snapshot repetido cada 5 min. La hora
// guardada es la hora en que el cron detectó el cambio, no el segundo exacto
// en que se editó en Sheets (esa precisión requeriría la API de edición de
// Google, fuera de alcance por ahora -- decisión explícita del usuario).
model CountryRateHistory {
  id         Int      @id @default(autoincrement())
  country    String
  buyRate    Decimal? @db.Decimal(18, 6)
  sellRate   Decimal? @db.Decimal(18, 6)
  recordedAt DateTime @default(now())

  @@index([country, recordedAt])
}

model P2PBotMarketSnapshot {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  exchange    String
  side        String   @default("1")
  cycleAt     DateTime @default(now())
  competitors Json     @default("[]")
  ourAd       Json?
  targetPrice Decimal? @db.Decimal(18, 4)
  createdAt   DateTime @default(now())

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, exchange, cycleAt])
  @@index([tenantId, cycleAt])
}

